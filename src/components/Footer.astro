---
import { getCollection } from "astro:content";
import { clinic } from "../data/clinic";
import { treatments } from "../data/treatments";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const year = new Date().getFullYear();
---

<footer class="site">
  <div class="wrap foot-links">
    <nav aria-label="Treatments">
      <p class="foot-head">Treatments</p>
      <ul>
        {treatments.map((t) => (
          <li><a href={`/treatments/${t.slug}/`}>{t.name}</a></li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Patient guides">
      <p class="foot-head">Patient guides</p>
      <ul>
        {posts.map((p) => (
          <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>
        ))}
        <li><a href="/blog/">All articles</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap">
    <span>© {year} {clinic.fullName}, Wanowrie (Wanwadi), Pune</span>
    <span><a href={`tel:${clinic.phoneE164}`}>{clinic.phoneDisplay}</a></span>
  </div>
</footer>
