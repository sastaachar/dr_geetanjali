---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Visit from "../../components/Visit.astro";
import Footer from "../../components/Footer.astro";
import { clinic } from "../../data/clinic";
import { treatments } from "../../data/treatments";

const title = "Dental Treatments in Wanowrie, Pune | Dr. Geetanjali’s Dental Care";
const description = `Every dental treatment at Dr. Geetanjali’s Dental Care, Wanwadi (Wanowrie), Pune — implants, root canal, cleaning, kids’ dentistry, crowns, dentures and emergency care. Call ${clinic.phoneDisplay}.`;

const siteRoot = new URL("/", Astro.site).href;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteRoot },
    { "@type": "ListItem", position: 2, name: "Treatments", item: siteRoot + "treatments/" },
  ],
};
---

<Base title={title} description={description} schemas={[breadcrumbSchema]}>
  <Header />
  <main id="top">
    <section class="treatment-hero">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Treatments</span>
        </nav>
        <p class="eyebrow">What we treat</p>
        <h1>Dental treatments in Wanowrie, Pune</h1>
        <p class="lede">
          Complete dental care under one roof at our clinic in Wanwadi, near Jambhulkar Chowk —
          serving Wanowrie, Fatima Nagar, Salunkhe Vihar, NIBM Road and Pune Camp. Every treatment
          starts with a clear explanation of what’s needed, why, and what it will cost.
        </p>
        <div class="cta-row">
          <button class="call-btn" data-book>Book an appointment</button>
          <a class="cta-secondary" href={`tel:${clinic.phoneE164}`}>Call {clinic.phoneDisplay}</a>
        </div>
      </div>
    </section>

    <section class="treatment-list">
      <div class="wrap">
        <div class="svc-grid">
          {treatments.map((t) => (
            <a class="svc svc-link" href={`/treatments/${t.slug}/`}>
              <h3>{t.name}</h3>
              <p>{t.short}</p>
              <span class="more">Learn more →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <Visit />
  </main>
  <Footer />
</Base>
