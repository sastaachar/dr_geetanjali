---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { clinic } from "../data/clinic";
import { treatments } from "../data/treatments";

const title = "Page not found | Dr. Geetanjali’s Dental Care, Wanowrie (Wanwadi)";
const description =
  "That page doesn’t exist. Find our treatments, patient guides and clinic address, or call the clinic directly.";

// The handful of pages a lost visitor most likely wanted.
const popular = treatments.slice(0, 6);
---

<Base title={title} description={description} noindex>
  <Header />
  <main id="top">
    <section class="treatment-hero">
      <div class="wrap">
        <p class="eyebrow">404</p>
        <h1>We couldn’t find that page</h1>
        <p class="lede">
          The link may be old or mistyped. Nothing is wrong with your teeth, just this URL.
          Here’s the way back.
        </p>
        <div class="cta-row">
          <a class="call-btn" href="/">Go to the homepage</a>
          <a class="cta-secondary" href={`tel:${clinic.phoneE164}`}>Call {clinic.phoneDisplay}</a>
        </div>
      </div>
    </section>

    <section class="treatment-list">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Popular pages</p>
          <h2>Looking for one of these?</h2>
        </div>
        <div class="svc-grid">
          {popular.map((t) => (
            <a class="svc svc-link" href={`/treatments/${t.slug}/`}>
              <h3>{t.name}</h3>
              <p>{t.short}</p>
              <span class="more">Learn more →</span>
            </a>
          ))}
        </div>
        <div class="cta-row">
          <a class="cta-secondary" href="/treatments/">All treatments</a>
          <a class="cta-secondary" href="/blog/">Patient guides</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
