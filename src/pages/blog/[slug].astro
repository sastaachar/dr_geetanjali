---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Visit from "../../components/Visit.astro";
import Footer from "../../components/Footer.astro";
import { clinic } from "../../data/clinic";
import { getTreatment } from "../../data/treatments";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const relatedTreatments = post.data.treatments
  .map((s) => getTreatment(s))
  .filter((t) => t !== undefined);

const siteRoot = new URL("/", Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  url: pageUrl,
  author: {
    "@type": "Person",
    name: clinic.doctor.name,
    jobTitle: clinic.doctor.role,
  },
  publisher: { "@id": siteRoot + "#clinic" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteRoot },
    { "@type": "ListItem", position: 2, name: "Blog", item: siteRoot + "blog/" },
    { "@type": "ListItem", position: 3, name: post.data.title, item: pageUrl },
  ],
};

const dateFmt = new Intl.DateTimeFormat("en-IN", { day: "numeric", month: "long", year: "numeric" });
---

<Base title={`${post.data.title} | Dr. Geetanjali’s Dental Care`} description={post.data.description} schemas={[articleSchema, breadcrumbSchema]}>
  <Header />
  <main id="top">
    <article class="post">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{post.data.title}</span>
        </nav>
        <header class="post-head">
          <h1>{post.data.title}</h1>
          <p class="byline">
            By {clinic.doctor.name}, {clinic.doctor.role} ·
            <time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time>
          </p>
        </header>
        <div class="post-body">
          <Content />
        </div>

        <div class="post-cta">
          <p class="eyebrow">Have a question about your teeth?</p>
          <div class="cta-row">
            <button class="call-btn" data-book>Book an appointment</button>
            <a class="cta-secondary" href={clinic.whatsapp} target="_blank" rel="noopener">WhatsApp us</a>
            <a class="cta-secondary" href={`tel:${clinic.phoneE164}`}>Call {clinic.phoneDisplay}</a>
          </div>
        </div>

        {relatedTreatments.length > 0 && (
          <aside class="post-related">
            <p class="eyebrow">Related treatments</p>
            <div class="svc-grid">
              {relatedTreatments.map((t) => (
                <a class="svc svc-link" href={`/treatments/${t.slug}/`}>
                  <h3>{t.name}</h3>
                  <p>{t.short}</p>
                  <span class="more">Learn more →</span>
                </a>
              ))}
            </div>
          </aside>
        )}
      </div>
    </article>

    <Visit />
  </main>
  <Footer />
</Base>
